@using XeniaBot.WebPanel.Areas.BanSync.Models.MutualRecords
@model MutualRecordsListComponentModel
@{
    Layout = null;

    var url = "/BanSync/Search/MutualRecords/"+Model.GuildId+"/PageComponent";
    if (Model.ForUserId.HasValue)
    {
        url += "?forUser=" + Model.ForUserId.Value.ToString("D");
    }
}

@if (Model.Items.Count < 1)
{
    <div class="px-4 py-5 my-5 text-center">
        <h4>No Records Found</h4>
        <p>No members in your server have any records in the database.</p>
    </div>
}
else
{
    <table class="table table-bordered table-sm table-fs-listing" id="bansyncRecordList">
        <thead>
            <tr>
                <th>User</th>
                <th>Guild</th>
                <th>Timestamp</th>
                <th>Reason</th>
                <th></th>
            </tr>
        </thead>
        <tbody hx-get="@url"
               hx-target="this"
               hx-swap="innerHTML"
               hx-trigger="load"
               hx-indicator=".htmx-indicator"
               id="bansyncRecordListBody">
        </tbody>
    </table>
    <div class="d-flex justify-content-center">
        <div class="spinner-border htmx-indicator" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}